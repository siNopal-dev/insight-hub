{
  "name": "insight-hub-nextjs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "session:revoke": "node --env-file=.env.local scripts/revoke-sessions.mjs",
    "config:import": "node scripts/import-ci-env.mjs",
    "db:secure": "node --env-file=.env.local scripts/secure-legacy-api.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
